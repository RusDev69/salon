# ---------------------------------------------------------------------------
# Local demo (no external services required)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
NEXT_PUBLIC_SALON_TIMEZONE="Europe/Moscow"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Production: Supabase
# Leave these empty to use the self-contained Prisma/SQLite demo.
# Supabase Auth is enabled only when URL + anon key + service role key are set.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Supabase Postgres pooled connection used by Prisma.
# Use the Transaction pooler URL (port 6543) on Vercel/serverless.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ---------------------------------------------------------------------------
# Telegram notifications
# Create a bot via @BotFather and paste the token here.
# Subscribers are collected by the webhook after they send /start to the bot.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"
# Optional extra recipients: personal chat id or group/channel id/username.
TELEGRAM_CHAT_ID=""
TELEGRAM_CHAT_IDS=""
