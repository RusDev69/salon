// Локальная схема для демо (SQLite).
// Production-схема Supabase: prisma/schema.supabase.prisma + supabase/migrations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("OWNER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Service {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  category    String
  durationMin Int
  price       Int
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  masters     MasterService[]
  bookings    Booking[]

  @@map("services")
}

model Master {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  specialty       String
  bio             String
  photoUrl        String
  rating          Float           @default(5)
  reviewsCount    Int             @default(0)
  experienceYears Int             @default(5)
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  services        MasterService[]
  bookings        Booking[]
  slots           SlotBlock[]
  schedules       MasterSchedule[]

  @@map("masters")
}

model MasterSchedule {
  id        String   @id @default(cuid())
  masterId  String
  dayOfWeek Int
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, dayOfWeek, startTime])
  @@index([masterId, dayOfWeek])
  @@map("master_schedules")
}

model MasterService {
  masterId  String
  serviceId String
  master    Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
  @@map("master_services")
}

model Booking {
  id            String   @id @default(cuid())
  reference     String   @unique
  customerName  String
  customerPhone String
  customerEmail String?
  notes         String?
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("PENDING")
  serviceId     String
  masterId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  service       Service  @relation(fields: [serviceId], references: [id])
  master        Master   @relation(fields: [masterId], references: [id])

  @@index([masterId, startsAt])
  @@index([status])
  @@map("bookings")
}

model SlotBlock {
  id        String   @id @default(cuid())
  masterId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, startsAt])
  @@index([startsAt])
  @@map("slot_blocks")
}

model TelegramSubscriber {
  id        String   @id @default(cuid())
  chatId    String   @unique
  username  String?
  firstName String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("telegram_subscribers")
}
