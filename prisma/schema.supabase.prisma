// ============================================================================
// ÉCLAT — production Prisma schema for Supabase Postgres.
//
// The canonical SQL (tables, RLS, triggers, RPC) lives in
// supabase/migrations. This file is the ORM view used by the Next.js server
// when DATABASE_URL points at Supabase's pooled Postgres connection.
//
// Usage:
//   cp prisma/schema.supabase.prisma prisma/schema.prisma
//   pnpm prisma generate
//   pnpm build
//
// Keep camelCase in TypeScript and snake_case in Postgres via @map. RLS is
// enforced for PostgREST/supabase-js clients; the trusted server connection
// still re-validates every mutation.
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT  @map("client")
  OWNER   @map("owner")
  MASTER  @map("master")
}

enum BookingStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  CANCELLED @map("cancelled")
  COMPLETED @map("completed")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String   @map("full_name")
  role         UserRole @default(CLIENT)
  avatarUrl    String?  @map("avatar_url")
  passwordHash String   @default("") @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Service {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  name        String
  description String
  category    String
  durationMin Int             @map("duration_minutes")
  price       Int
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  masters     MasterService[]
  bookings    Booking[]

  @@index([isActive, sortOrder])
  @@map("services")
}

model Master {
  id              String          @id @default(uuid()) @db.Uuid
  slug            String          @unique
  name            String
  specialty       String          @map("specialization")
  bio             String
  photoUrl        String          @map("photo_url")
  rating          Float           @default(5)
  reviewsCount    Int             @default(0) @map("reviews_count")
  experienceYears Int             @default(1) @map("experience_years")
  isActive        Boolean         @default(true) @map("is_active")
  sortOrder       Int             @default(0) @map("sort_order")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  services        MasterService[]
  bookings        Booking[]
  slots           SlotBlock[]
  schedules       MasterSchedule[]

  @@index([isActive, sortOrder])
  @@map("masters")
}

model MasterService {
  masterId  String  @map("master_id") @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  master    Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
  @@index([serviceId])
  @@map("master_services")
}

model MasterSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  masterId  String   @map("master_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, dayOfWeek, startTime])
  @@index([masterId, dayOfWeek])
  @@map("master_schedules")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  reference     String        @unique
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  customerEmail String?       @map("customer_email")
  notes         String?
  startsAt      DateTime      @map("start_time")
  endsAt        DateTime      @map("end_time")
  status        BookingStatus @default(PENDING)
  serviceId     String        @map("service_id") @db.Uuid
  masterId      String        @map("master_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  service       Service       @relation(fields: [serviceId], references: [id])
  master        Master        @relation(fields: [masterId], references: [id])

  @@index([masterId, startsAt])
  @@index([status, startsAt])
  @@map("bookings")
}

model SlotBlock {
  id        String   @id @default(uuid()) @db.Uuid
  masterId  String   @map("master_id") @db.Uuid
  startsAt  DateTime @map("start_time")
  endsAt    DateTime @map("end_time")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, startsAt])
  @@index([startsAt])
  @@map("slot_blocks")
}

model TelegramSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @unique @map("chat_id")
  username  String?
  firstName String?  @map("first_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("telegram_subscribers")
}
